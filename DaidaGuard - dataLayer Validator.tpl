    assertApi('gtmOnSuccess').wasNotCalled();
- name: Config written before inject
  code: |-
    var guardRegistryState = null;
    var injectCalled = false;
    var targetDataLayer = 'dataLayer';

    mock('copyFromWindow', function(key) {
      if (key === '__DAIDA_GUARD__') {
        // If it hasn't been initialized yet by the tag or a previous run, return an empty base structure
        if (!guardRegistryState) {
          return { instanceActive: false, interceptors: {}, pendingConfigs: [], debugHistory: [] };
        }
        return guardRegistryState;
      }
      return null;
    });

    mock('setInWindow', function(key, value) {
      if (key === '__DAIDA_GUARD__') {
        guardRegistryState = value;
      }
    });

    mock('injectScript', function(url, onSuccess, onFailure) {
      injectCalled = true;
      onSuccess();
    });

    mock('logToConsole', function(msg) {});

    var mockData = {
      orgId: 'my-org',
      accountId: 'my-account',
      dataLayerName: targetDataLayer,
      debugMode: false
    };

    runCode(mockData);

    // Validate against the unified global registry state array
    assertThat(guardRegistryState).isNotNull();
    assertThat(guardRegistryState.pendingConfigs).isNotNull();
    assertThat(guardRegistryState.pendingConfigs.length).isEqualTo(1);

    var capturedConfig = guardRegistryState.pendingConfigs[0];
    assertThat(capturedConfig.orgId).isEqualTo('my-org');
    assertThat(capturedConfig.accountId).isEqualTo('my-account');
    assertThat(capturedConfig.dataLayerName).isEqualTo('dataLayer');
    assertApi('gtmOnSuccess').wasCalled();
- name: Debug mode enables console logging
  code: |
    var logCalled = false;

    mock('logToConsole', function(msg) {
      logCalled = true;
    });

    mock('setInWindow', function(key, value) {});

    mock('injectScript', function(url, onSuccess, onFailure, cacheToken) {
      onSuccess();
    });

    var mockData = {
      orgId: 'test-org',
      accountId: 'test-account',
      dataLayerName: 'dataLayer',
      debugMode: true
    };

    runCode(mockData);

    assertThat(logCalled).isTrue();
    assertApi('gtmOnSuccess').wasCalled();
- name: Cache token set to prevent double-load
  code: |-
    var capturedUrl = null;

    mock('injectScript', function(url, onSuccess, onFailure) {
      capturedUrl = url;
      onSuccess();
    });

    mock('setInWindow', function(key, value) {});
    mock('copyFromWindow', function(key) {
      if (key === '__DAIDA_GUARD__') {
        return { instanceActive: false, interceptors: {}, pendingConfigs: [], debugHistory: [] };
      }
      return null;
    });
    mock('logToConsole', function(msg) {});

    var mockData = {
      orgId: 'test-org',
      accountId: 'test-account',
      dataLayerName: 'dataLayer',
      debugMode: false
    };

    runCode(mockData);

    assertThat(capturedUrl).contains('org=test-org');
    assertThat(capturedUrl).contains('dl=dataLayer');
    assertApi('gtmOnSuccess').wasCalled();
